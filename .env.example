# Copy to .env locally; set the same names as environment variables on Render.
# Nothing here is secret in this file — it is committed. Put the real values in
# .env (gitignored) and in Render's Environment tab.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Anything that is not 127.0.0.1/localhost is
# treated as real data: the server then refuses to start unless ADMIN_USER,
# ADMIN_PASS and SESSION_SECRET are set, even if NODE_ENV is missing.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=blueprint

# ─── Accounts ─────────────────────────────────────────────────────────────────
# The FIRST account is seeded from these, once, only while the users collection
# is empty — after that they are ignored except that ADMIN_USER is kept as the
# owner (the tier that manages the team). 2FA is set up on that account's first
# login. Use the real person's name, e.g. annie.
ADMIN_USER=
ADMIN_PASS=
# Signs the session cookie and the short-lived 2FA pending token. At least 32
# characters of real randomness (`openssl rand -hex 32`); changing it signs
# everyone out. Unset locally, a random one is generated per boot.
SESSION_SECRET=

# ─── Events ───────────────────────────────────────────────────────────────────
# The events live in the `shows` collection and are managed in the admin, so
# these two are only the fallback used before that collection is seeded.
# SHOW_ID is the event used when a request names none.
SHOW_ID=LEX26
# SHOWS is a comma-separated list of slug:ID pairs giving each event its URL
# segment (/floorplan/lex, /admin/lna). Leave empty unless you are standing up a
# deployment with no database to read the registry from.
SHOWS=

# ─── Public floorplan ─────────────────────────────────────────────────────────
# Origin allowed to open a socket, e.g. https://your-app.onrender.com
PUBLIC_ORIGIN=
# Origins allowed to EMBED /floorplan in an <iframe> — the marketing site.
# Comma-separated, scheme and host only, no trailing path. Unset, only this site
# may frame it. Every other page (/admin, /sales, /login) is never frameable.
EMBED_ORIGINS=https://www.example.com,https://example.com
# The artwork served for an event that has no plan uploaded yet. A file in
# public/. Uploading a plan in the admin supersedes it per event.
FLOORPLAN_SVG=/LEX27_Floorplan_Consolidated.svg
# €/m², used to derive a stand's list price and to size sponsorship
# recommendations. A rate set in the admin overrides this per event.
RATE_PER_SQM=600

# ─── Data failsafe (optional, off unless set) ─────────────────────────────────
# A key that ONLY you know — not your admin password, and never in the code.
# When set, the data-destroying admin actions (releasing a booked stand, forcing
# a booked stand back to Available, changing the rate) require it, so a stolen
# admin session still cannot erase bookings. Five wrong attempts pause that
# account for 15 minutes, and every failure is written to the audit trail.
RECOVERY_KEY=

# ─── Privacy / retention ──────────────────────────────────────────────────────
# How long raw behavioural events are kept. Drives a TTL index on `activity`.
# This number must match your privacy policy. Changing it is safe: the server
# updates the existing index in place on the next boot.
ACTIVITY_RETENTION_DAYS=730

# ─── Optional integrations ────────────────────────────────────────────────────
# Webhook posted a JSON body when an enquiry is forwarded (Zapier/Make/Slack/CRM)
NOTIFY_WEBHOOK=
